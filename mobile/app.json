{
  "expo": {
    "name": "JOANA IA",
    "slug": "joana-ia",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "joanaia",
    "description": "Assistente educativa sobre aprendizagem profissional no Brasil.",
    "splash": {
      "image": "./assets/android-icon-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#6B55D9"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "br.ia.joana",
      "versionCode": 1,
      "targetSdkVersion": 36,
      "adaptiveIcon": {
        "backgroundColor": "#6B55D9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
